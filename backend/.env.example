# Backend environment — copy to .env (git-ignored) and fill in. Never commit real values.

# Database (Neon Postgres)
DATABASE_URL=jdbc:postgresql://localhost:5432/supportflow
DATABASE_USERNAME=supportflow
DATABASE_PASSWORD=supportflow

# Auth
JWT_SECRET=
AUTH_ALLOWLIST=youremail@example.com

# OAuth providers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# AI advisor
GEMINI_API_KEY=

# Atlassian (shared by Jira + Confluence)
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
JIRA_BASE_URL=
CONFLUENCE_BASE_URL=

# Qase
QASE_API_TOKEN=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
